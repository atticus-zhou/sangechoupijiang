      },
      {
        "failure_type": "word_canvas_missing_or_stale",
        "return_to_stage": "delivery_build",
        "preserve": [
          "story",
          "asset_identity_cards",
          "generated_images",
          "visual_reviews",
          "prompt_director_contract"
        ],
        "clear": [
          "stale_word_canvas",
          "stale_trace",
