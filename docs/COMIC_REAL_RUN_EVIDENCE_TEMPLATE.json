        "operator_next_step": "重新生成失败图片，重跑刑部视觉质检，再刷新 Word 画布和 trace。"
      },
      {
        "failure_type": "asset_split_failed",
        "return_to_stage": "asset_review",
        "preserve": [
          "story"
        ],
        "clear": [
          "asset_identity_cards",
          "reference_asset_chain",
          "prompt_strategy_lineage",
          "generated_images"
        ],
